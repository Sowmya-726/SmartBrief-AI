{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: Uvicorn",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe -m uvicorn main:app --reload --host 127.0.0.1 --port 8000",
      "options": {
        "cwd": "${workspaceFolder}\\backend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Uvicorn running on.*|.*Started reloader process.*",
          "endsPattern": ".*Application startup complete.*|.*Uvicorn running on.*"
        }
      }
    },
    {
      "label": "Frontend: Vite",
      "type": "shell",
      "command": "npm run dev -- --host 127.0.0.1 --port 5173",
      "options": {
        "cwd": "${workspaceFolder}\\frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*Local:\\s+http://127\\.0\\.0\\.1:5173/.*|.*ready in .*"
        }
      }
    },
    {
      "label": "Start Full Stack",
      "dependsOn": [
        "Backend: Uvicorn",
        "Frontend: Vite"
      ],
      "dependsOrder": "parallel"
    }
  ]
}
